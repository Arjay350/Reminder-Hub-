<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_item_background"
    android:gravity="center_vertical">

    <!-- Status Indicator - ImageView required for RemoteViews (View not allowed) -->
    <ImageView
        android:id="@+id/widget_item_status_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_status_dot"
        android:contentDescription="Bill status" />

    <!-- Bill Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internet Bill"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="₱1,500 • Due Aug 28"
            android:textSize="10.5sp"
            android:textColor="#94A3B8"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:background="@drawable/widget_badge_unpaid"
            android:text="UNPAID"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/widget_item_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="₱1,500"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#14B8A6"
        android:gravity="end" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/widget_icon_circle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_icon_circle_bg">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="School"
                android:src="@drawable/ic_widget_school" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCHOOL"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_date_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_btn_view_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_button_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_btn_view_schedule_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule"
                android:textColor="#5EEAD4"
                android:textSize="9sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginStart="2dp"
                android:contentDescription="Open schedule"
                android:src="@drawable/ic_widget_arrow_right" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_highlight_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_next_class_bg"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="8dp"
        android:paddingEnd="11dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_next"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="NEXT CLASS"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_class_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="2:00 PM – 3:00 PM"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />
            <LinearLayout
                android:id="@+id/widget_countdown_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_countdown_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:contentDescription="Countdown"
                    android:src="@drawable/ic_widget_clock" />
                <TextView
                    android:id="@+id/widget_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="Starts in 38 min"
                    android:textColor="#C4B5FD"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/widget_class_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Database Management"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/widget_class_details_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/widget_class_room_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_class_room_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Room"
                    android:src="@drawable/ic_widget_location" />
                <TextView
                    android:id="@+id/widget_class_room"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Room 302"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/widget_class_teacher_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_class_teacher_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Instructor"
                    android:src="@drawable/ic_widget_person" />
                <TextView
                    android:id="@+id/widget_class_teacher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Instructor"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_section_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TODAY’S TIMELINE"
            android:textColor="#CBD5E1"
            android:textSize="9sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="Refresh schedule"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <ListView
            android:id="@+id/widget_classes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:scrollbars="none" />
        <LinearLayout
            android:id="@+id/widget_empty_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You’re all caught up"
                android:textColor="#5EEAD4"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Nothing else scheduled today"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. Header Bar -->
    <LinearLayout
        android:id="@+id/widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App / School Icon in Circle -->
        <FrameLayout
            android:id="@+id/widget_icon_circle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_icon_circle_bg"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_school"
                android:contentDescription="School Icon" />
        </FrameLayout>

        <!-- Title & Date Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today\'s Classes"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monday, Aug 24"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- "View Schedule" Action Button -->
        <LinearLayout
            android:id="@+id/widget_btn_view_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_button_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_btn_view_schedule_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Schedule"
                android:textColor="#A78BFA"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_widget_arrow_right"
                android:contentDescription="Go" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="#242E4C"
        android:contentDescription="divider" />

    <!-- 2. Highlighted Active / Upcoming / Completed Card -->
    <LinearLayout
        android:id="@+id/widget_highlight_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_current_class_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Status Badge & Countdown Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_current"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="CURRENT CLASS"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_class_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="06:30 PM – 07:30 PM"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Real-time Countdown Badge (e.g. Ends in 16m / Starts in 45m) -->
            <LinearLayout
                android:id="@+id/widget_countdown_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_countdown_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_clock"
                    android:contentDescription="Timer" />

                <TextView
                    android:id="@+id/widget_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="Ends in 16m"
                    android:textColor="#22C55E"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Subject Name -->
        <TextView
            android:id="@+id/widget_class_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Usable Security"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Details Row (Room / Mode, Teacher) -->
        <LinearLayout
            android:id="@+id/widget_class_details_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Room / Mode layout -->
            <LinearLayout
                android:id="@+id/widget_class_room_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_class_room_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_location"
                    android:contentDescription="Room" />

                <TextView
                    android:id="@+id/widget_class_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Room: Q-5207F"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Teacher layout -->
            <LinearLayout
                android:id="@+id/widget_class_teacher_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_class_teacher_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_person"
                    android:contentDescription="Teacher" />

                <TextView
                    android:id="@+id/widget_class_teacher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Prof. Santos"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Section Title Row (e.g. Other classes Monday (7):) -->
    <LinearLayout
        android:id="@+id/widget_section_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Other classes Monday (7):"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Refresh Button -->
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh Widget" />
    </LinearLayout>

    <!-- 4. Scrollable Classes List & Empty View Container -->
    <FrameLayout
        android:id="@+id/widget_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Empty State Layout -->
        <LinearLayout
            android:id="@+id/widget_empty_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No classes scheduled for today"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap to open Reminder Hub schedule"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- True Scrollable ListView (Interactive collection) -->
        <ListView
            android:id="@+id/widget_classes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="5dp"
            android:scrollbars="none"
            android:nestedScrollingEnabled="true"
            android:visibility="visible" />
    </FrameLayout>

</LinearLayout>
